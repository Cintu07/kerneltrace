   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "where it comes from: a key bias softmax can't see",
   "originalText": "where it comes from: a key bias softmax can't see",
   "fontSize": 34,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "text1003",
   "x": 42,
   "y": 78,
   "width": 1703.5200000000002,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#6e7781",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1004,
   "version": 1,
   "versionNonce": 1005,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "the part of each key bias that rotary leaves alone adds the same number to every score of a query. softmax removes it, so in exact math the loss never pushes back on it.",
   "originalText": "the part of each key bias that rotary leaves alone adds the same number to every score of a query. softmax removes it, so in exact math the loss never pushes back on it.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
