  {
   "type": "text",
   "id": "text1291",
   "x": 1300,
   "y": 548,
   "width": 571.2,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#6e7781",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1292,
   "version": 1,
   "versionNonce": 1293,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "blue: 3% or worse, or nan. pythia 1.4b still overflows fp16 with the\nbias dropped: hf multiplies q by k before scaling, and that hits\n129,160. keeping attention in fp32 fixes that one too.",
   "originalText": "blue: 3% or worse, or nan. pythia 1.4b still overflows fp16 with the\nbias dropped: hf multiplies q by k before scaling, and that hits\n129,160. keeping attention in fp32 fixes that one too.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "text1294",
   "x": 40,
   "y": 610,
   "width": 1590.4,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1f2328",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1295,
   "version": 1,
   "versionNonce": 1296,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "drop_invariant_key_bias(adapter) zeroes that part. in fp32 the logits move by at most 0.007, about as much as fp32 drifts between batch sizes.",
   "originalText": "drop_invariant_key_bias(adapter) zeroes that part. in fp32 the logits move by at most 0.007, about as much as fp32 drifts between batch sizes.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
