   "opacity": 100,
   "seed": 1229,
   "version": 1,
   "versionNonce": 1230,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "error is the median distance from the fp32 restoration, over\nevery prompt and layer. on gpt-2 small the bf16 error is mostly\nthe logits, rounded to steps of 0.5. an fp32 head alone gets 0.006.\n\npythia-1b is bigger than 410m and fine. size doesn't decide it.\nthe offsets do, and you can measure them before you patch.",
   "originalText": "error is the median distance from the fp32 restoration, over\nevery prompt and layer. on gpt-2 small the bf16 error is mostly\nthe logits, rounded to steps of 0.5. an fp32 head alone gets 0.006.\n\npythia-1b is bigger than 410m and fine. size doesn't decide it.\nthe offsets do, and you can measure them before you patch.",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
