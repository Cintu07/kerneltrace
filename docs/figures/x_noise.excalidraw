   "versionNonce": 2091,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "pythia's check failed because its logits are 5x bigger, so ordinary float rounding is bigger. running the same model at a\ndifferent batch size moves them just as much. the shuffle was exact and the check was wrong. the claim stays inconclusive anyway,\nrather than tuning the tolerance until it passes.",
   "originalText": "pythia's check failed because its logits are 5x bigger, so ordinary float rounding is bigger. running the same model at a\ndifferent batch size moves them just as much. the shuffle was exact and the check was wrong. the claim stays inconclusive anyway,\nrather than tuning the tolerance until it passes.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  }
