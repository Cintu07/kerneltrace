  {
   "type": "text",
   "id": "text1177",
   "x": 1010,
   "y": 510,
   "width": 730.8000000000001,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#6e7781",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1178,
   "version": 1,
   "versionNonce": 1179,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "in fp16 the invariant part's gradient is about 2,600x smaller than the rotary part's,\nand adam still gives it a step 1.16x as big. in fp32 the gradient sits under adam's eps\nand the step is near zero. a big eps kills the growth, and slows every other small\nweight too: the rotary part only reaches 2.18.",
   "originalText": "in fp16 the invariant part's gradient is about 2,600x smaller than the rotary part's,\nand adam still gives it a step 1.16x as big. in fp32 the gradient sits under adam's eps\nand the step is near zero. a big eps kills the growth, and slows every other small\nweight too: the rotary part only reaches 2.18.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "text1180",
   "x": 40,
   "y": 652,
   "width": 1646.4,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1f2328",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "seed": 1181,
   "version": 1,
   "versionNonce": 1182,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "keeping only attention in fp32 is enough to stop it. the leak is in the attention backward, and adam's normalisation turns it into full-size steps.",
   "originalText": "keeping only attention in fp32 is enough to stop it. the leak is in the attention backward, and adam's normalisation turns it into full-size steps.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
